# Copy to .env and fill in. All vars are prefixed REDFORGE_.
REDFORGE_ANTHROPIC_API_KEY=sk-ant-...
REDFORGE_MODEL_CHEAP=claude-haiku-4-5-20251001
REDFORGE_MODEL_STRONG=claude-opus-4-8
REDFORGE_SANDBOX_IMAGE=redforge-sandbox:latest
REDFORGE_SANDBOX_MEMORY=2g
REDFORGE_SANDBOX_CPUS=2.0
REDFORGE_SANDBOX_TIMEOUT_S=600
REDFORGE_POC_MAX_RETRIES=3
REDFORGE_POC_MAX_HYPOTHESES=5
REDFORGE_POC_PRIORITY_FLOOR=150
REDFORGE_POC_STOP_ON_FIRST_CONFIRMATION=true
REDFORGE_STRATEGIST_MIN_SEVERITY=low
REDFORGE_STRATEGIST_MAX_FINDINGS=80
REDFORGE_REMEDIATION_MAX_RETRIES=3
REDFORGE_HALMOS_TIMEOUT_S=120
REDFORGE_VERIFY_MAX_RETRIES=3
# Optional observability
REDFORGE_LANGFUSE_PUBLIC_KEY=
REDFORGE_LANGFUSE_SECRET_KEY=
